{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai:deployment-contract:0.2",
  "title": "Enterprise AI Deployment Contract",
  "type": "object",
  "required": [
    "schema_version",
    "deployment",
    "business_contract",
    "model_identity",
    "deployment_artifact",
    "serving_runtime",
    "inference_configuration",
    "evaluation_contract",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "deployment": {
      "type": "object",
      "required": [
        "deployment_id",
        "environment",
        "status",
        "owner"
      ],
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "reference-dev",
            "reference-stage",
            "customer-stage",
            "customer-prod"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "locked",
            "validated",
            "approved",
            "retired"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "business_contract": {
      "type": "object",
      "required": [
        "workflow_id",
        "workflow_name",
        "risk_class",
        "human_review"
      ],
      "properties": {
        "workflow_id": {
          "type": "string"
        },
        "workflow_name": {
          "type": "string"
        },
        "risk_class": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "human_review": {
          "enum": [
            "none",
            "sampled",
            "required"
          ]
        }
      }
    },
    "model_identity": {
      "type": "object",
      "required": [
        "model_family",
        "model_id",
        "revision"
      ],
      "properties": {
        "model_family": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "deployment_artifact": {
      "type": "object",
      "required": [
        "provider_or_source",
        "artifact_uri",
        "artifact_hash",
        "precision"
      ],
      "properties": {
        "provider_or_source": {
          "type": "string"
        },
        "artifact_uri": {
          "type": "string"
        },
        "artifact_hash": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        }
      }
    },
    "serving_runtime": {
      "type": "object",
      "required": [
        "engine",
        "version",
        "container_digest"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "container_digest": {
          "type": "string"
        }
      }
    },
    "inference_configuration": {
      "type": "object",
      "required": [
        "context_window",
        "max_output_tokens",
        "temperature",
        "top_p"
      ],
      "properties": {
        "context_window": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evaluation_contract": {
      "type": "object",
      "required": [
        "golden_eval_set_id",
        "reference_deployment_id",
        "mandatory_metrics"
      ],
      "properties": {
        "golden_eval_set_id": {
          "type": "string"
        },
        "reference_deployment_id": {
          "type": "string"
        },
        "mandatory_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "object"
    }
  },
  "additionalProperties": true
}